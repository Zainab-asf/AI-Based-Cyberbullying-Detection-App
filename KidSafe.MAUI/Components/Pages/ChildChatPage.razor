@page "/chat"
@inject ApiService Api
@inject AuthStateService AuthState
@inject ChatHubService Hub
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="chat-root">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <div class="wa-header">
        <button class="wa-back" @onclick='() => Nav.NavigateTo("/child-home")'>
            <i class="bi bi-arrow-left"></i>
        </button>
        <div class="wa-av">
            <UserAvatar Name="@(_selectedClassmate?.DisplayName ?? AuthState.CurrentUser?.DisplayName ?? "Student")" Size="xs" Role="child" />
        </div>
        <div class="wa-hd-info">
            <div class="wa-hd-name">
                @(_selectedClassmate?.DisplayName ?? (_className.Length > 0 ? _className : "Class Chat"))
            </div>
            <div class="wa-hd-sub">
                <span class="conn-dot @(_hubState == HubState.Connected ? "on" : "off")"></span>
                Online · AI Protected
            </div>
        </div>
        <div class="wa-shield-pill">
            <i class="bi bi-shield-check-fill"></i> AI Shield ON
        </div>
    </div>

    <!-- ── Classmates strip ────────────────────────────────────── -->
    <div class="wa-contacts">
        @if (_loadingClassmates)
        {
            <span style="font-size:.78rem;color:var(--text-m);align-self:center">Loading…</span>
        }
        else if (_classmates.Any())
        {
            @foreach (var cm in _classmates)
            {
                <button class="wa-contact @(_selectedClassmate?.Id == cm.Id ? "active" : "")"
                        @onclick="() => SelectClassmate(cm)">
                    <div class="wa-contact-av"><UserAvatar Name="@cm.DisplayName" Size="xs" Role="child" /></div>
                    <div class="wa-contact-name">@ShortName(cm.DisplayName)</div>
                </button>
            }
        }
        else
        {
            <span style="font-size:.78rem;color:var(--text-m);align-self:center;padding:.25rem 0">
                <i class="bi bi-info-circle"></i> No classmates yet
            </span>
        }
    </div>

    <!-- ── Toast ───────────────────────────────────────────────── -->
    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="chat-toast @_toastClass">@_toast</div>
    }

    <!-- ── Messages ────────────────────────────────────────────── -->
    <div class="wa-msgs" id="msg-list">
        @if (!_messages.Any())
        {
            <div class="chat-empty">
                <div class="chat-empty-ico">
                    <i class="bi bi-chat-heart-fill" style="font-size:3rem;color:var(--green-mid)"></i>
                </div>
                <div class="chat-empty-txt">
                    @(_selectedClassmate != null
                        ? $"Say hi to {ShortName(_selectedClassmate.DisplayName)}!"
                        : "Say hello to your classmates!")
                </div>
                <div class="chat-empty-sub">Be kind, be safe 💜</div>
            </div>
        }

        @foreach (var msg in _messages)
        {
            var mine = msg.SenderId == AuthState.CurrentUser?.UserId;
            <div class="wa-msg-row @(mine ? "mine" : "")">
                @if (!mine)
                {
                    <div class="wa-msg-av"><UserAvatar Name="@(_selectedClassmate?.DisplayName ?? "?")" Size="xs" Role="child" /></div>
                }
                <div class="wa-bbl-wrap">
                    @if (msg.Label == "Review")
                    {
                        <div class="wa-bbl blocked-bbl">
                            <i class="bi bi-shield-x-fill"></i> Blocked for safety
                        </div>
                    }
                    else
                    {
                        <div class="wa-bbl @(mine ? "mine" : "") @WaBblClass(msg)">@msg.Content</div>
                    }
                    <div class="wa-bbl-foot @(mine ? "right" : "")">
                        <span class="wa-time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                        @if (msg.Label == "Safe" && mine)
                        {
                            <span style="font-size:.58rem;color:var(--green-mid)">
                                <i class="bi bi-shield-check-fill"></i>
                            </span>
                        }
                        @if (msg.Label == "Watch")
                        {
                            <span class="wa-label watch"><i class="bi bi-eye-fill"></i> Watch</span>
                        }
                        @if (!mine)
                        {
                            <button class="wa-report-btn" title="Report" @onclick="() => ReportMsg(msg)">
                                <i class="bi bi-flag-fill"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_typingUser))
        {
            <div class="wa-msg-row">
                <div class="wa-msg-av"><UserAvatar Name="@(_typingUser)" Size="xs" Role="child" /></div>
                <div class="wa-bbl-wrap">
                    <div class="wa-bbl" style="padding:.45rem .85rem">
                        <div class="typing-dots">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ── Quick replies ───────────────────────────────────────── -->
    <div class="wa-quick">
        @foreach (var r in _quickReplies)
        {
            <button class="quick-chip" @onclick="() => _input = r">@r</button>
        }
    </div>

    <!-- ── Emoji picker ────────────────────────────────────────── -->
    @if (_showEmoji)
    {
        <div class="wa-emoji-panel">
            @foreach (var e in _emojis)
            {
                <button class="emoji-chip" @onclick="() => AppendEmoji(e)">@e</button>
            }
        </div>
    }

    <!-- ── Input bar ───────────────────────────────────────────── -->
    <div class="wa-input-bar">
        <button class="wa-emoji-btn" @onclick="() => _showEmoji = !_showEmoji" title="Emoji">
            <i class="bi bi-emoji-smile-fill"></i>
        </button>
        <input class="wa-field" @bind="_input" @bind:event="oninput"
               @onkeyup="OnKey" placeholder="Type a kind message…" />
        <button class="wa-send @(_sending ? "busy" : "")" @onclick="Send" disabled="@_sending">
            @if (_sending)
            {
                <i class="bi bi-hourglass-split"></i>
            }
            else
            {
                <i class="bi bi-send-fill"></i>
            }
        </button>
    </div>

    <!-- ── Bottom nav ─────────────────────────────────────────── -->
    <nav class="mobile-nav">
        <button class="mnav-item" @onclick='() => Nav.NavigateTo("/child-home")'>
            <i class="bi bi-house-fill"></i><span>Home</span>
        </button>
        <button class="mnav-item active">
            <i class="bi bi-chat-fill"></i><span>Chat</span>
        </button>
        <button class="mnav-item" @onclick='() => Nav.NavigateTo("/notifications")'>
            <i class="bi bi-bell-fill"></i><span>Alerts</span>
        </button>
        <button class="mnav-item" @onclick='() => Nav.NavigateTo("/profile")'>
            <i class="bi bi-person-circle"></i><span>Profile</span>
        </button>
    </nav>

</div>

