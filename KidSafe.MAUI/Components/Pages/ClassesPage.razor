@page "/classes"
@inject ApiService Api
@inject AuthStateService AuthState
@inject SidebarService Sidebar
@inject ChatHubService Hub
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="app-root">

    <AppSidebar>
        <NavContent>
            <NavGroup Title="Navigation">
                <button class="nav-item" @onclick="GoBack">
                    <span class="ni"><i class="bi bi-arrow-left"></i></span><span>Back</span>
                </button>
                <button class="nav-item active">
                    <span class="ni"><i class="bi bi-journal-bookmark-fill"></i></span><span>Classes</span>
                </button>
            </NavGroup>
            <NavGroup Title="Account">
                <button class="nav-item" @onclick='() => Nav.NavigateTo("/notifications")'>
                    <span class="ni"><i class="bi bi-bell-fill"></i></span><span>Notifications</span>
                    @if (_unreadCount > 0) { <span class="nb">@_unreadCount</span> }
                </button>
                <button class="nav-item" @onclick='() => Nav.NavigateTo("/profile")'>
                    <span class="ni"><i class="bi bi-person-circle"></i></span><span>Profile</span>
                </button>
            </NavGroup>
        </NavContent>
    </AppSidebar>

    <div class="main-area">
        <header class="top-header">
            <button class="sidebar-toggle" @onclick="Sidebar.ToggleDrawer" title="Menu">
                <i class="bi bi-list"></i>
            </button>
            <div class="header-title"><i class="bi bi-journal-bookmark-fill"></i> My Classes</div>
            <div class="header-actions" style="margin-left:auto">
                <button class="header-btn" @onclick="LoadClasses" title="Refresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </header>

        <div class="page-content">

            @if (_loading)
            {
                <div class="loading-block">
                    <div class="spin-ring"></div>
                    <div>Loading classes…</div>
                </div>
            }
            else if (_classes.Count == 0)
            {
                <div class="empty-block">
                    <div><i class="bi bi-journal-bookmark-fill" style="font-size:3rem;color:var(--text-m)"></i></div>
                    <div>No classes yet</div>
                    <div style="font-size:.83rem;color:var(--text-m)">You are not enrolled in any classes</div>
                </div>
            }
            else if (_activeClass == null)
            {
                <!-- Class grid -->
                <div class="page-head">
                    <h1>My Classes</h1>
                    <p>Select a class to view content and chat</p>
                </div>
                <div class="grid-auto">
                    @foreach (var cls in _classes)
                    {
                        <div class="class-card" @onclick="() => OpenClass(cls)">
                            <div class="class-card-icon"><i class="bi bi-book-fill" style="font-size:1.6rem;color:var(--blue)"></i></div>
                            <div class="class-card-name">@cls.Name</div>
                            <div class="class-card-sub">@cls.Subject • @cls.Section</div>
                            @if (!string.IsNullOrEmpty(cls.Teacher))
                            {
                                <div class="class-card-teacher"><i class="bi bi-mortarboard-fill"></i> @cls.Teacher</div>
                            }
                            <div class="class-card-stats">
                                <span><i class="bi bi-people-fill"></i> @cls.StudentCount</span>
                                @if (cls.ContentCount > 0) { <span><i class="bi bi-file-text-fill"></i> @cls.ContentCount</span> }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Class detail: tab bar + content/chat -->
                <div class="cls-detail-header">
                    <button class="cls-back-btn" @onclick="BackToClasses"><i class="bi bi-arrow-left"></i> Classes</button>
                    <div class="cls-detail-name">@_activeClass.Name</div>
                    <div class="cls-detail-sub">@_activeClass.Subject • @_activeClass.Section</div>
                </div>

                <div class="cls-tabs">
                    <button class="cls-tab @(_tab == "chat" ? "active" : "")" @onclick='() => SetTab("chat")'><i class="bi bi-chat-fill"></i> Chat</button>
                    <button class="cls-tab @(_tab == "content" ? "active" : "")" @onclick='() => SetTab("content")'><i class="bi bi-file-text-fill"></i> Content</button>
                    <button class="cls-tab @(_tab == "members" ? "active" : "")" @onclick='() => SetTab("members")'><i class="bi bi-people-fill"></i> Members</button>
                    @if (IsTeacher)
                    {
                        <button class="cls-tab @(_tab == "upload" ? "active" : "")" @onclick='() => SetTab("upload")'><i class="bi bi-cloud-upload-fill"></i> Upload</button>
                    }
                </div>

                <!-- CHAT TAB -->
                @if (_tab == "chat")
                {
                    <div class="cls-chat-area">
                        <div class="cls-chat-msgs" id="cls-msg-list">
                            @if (!_classMsgs.Any())
                            {
                                <div class="chat-empty">
                                    <div class="chat-empty-ico"><i class="bi bi-chat-heart-fill" style="font-size:2rem;color:var(--text-m)"></i></div>
                                    <div class="chat-empty-txt">No messages yet. Say hi!</div>
                                </div>
                            }
                            @foreach (var msg in _classMsgs)
                            {
                                var mine = msg.SenderId == AuthState.CurrentUser?.UserId;
                                <div class="msg-row @(mine ? "mine" : "")">
                                    @if (!mine)
                                    {
                                        <div class="msg-av"><UserAvatar Name="@msg.SenderName" Size="xs" /></div>
                                    }
                                    <div class="bbl-wrap">
                                        @if (!mine)
                                        {
                                            <div class="bbl-sender">@msg.SenderName</div>
                                        }
                                        <div class="bbl @BubbleClass(msg)">@msg.Content</div>
                                        <div class="bbl-meta">
                                            <span class="bbl-time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                            @if (msg.Label is not ("Safe" or "pending"))
                                            {
                                                <span class="bbl-badge @msg.Label.ToLower()">@msg.Label</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_typingUser))
                            {
                                <div class="typing-row">
                                    <div class="msg-av"><i class="bi bi-person-circle" style="font-size:1.3rem"></i></div>
                                    <span class="typing-lbl">@_typingUser is typing</span>
                                    <div class="typing-dots"><span></span><span></span><span></span></div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_chatToast))
                        {
                            <div class="chat-toast @_chatToastClass">@_chatToast</div>
                        }

                        <div class="cls-chat-input">
                            <input class="msg-field" @bind="_chatInput" @bind:event="oninput"
                                   @onkeyup="OnChatKey" placeholder="Message @_activeClass.Name…" />
                            <button class="send-btn @(_chatSending ? "busy" : "")"
                                    @onclick="SendClassMsg" disabled="@_chatSending">
                                <i class="bi @(_chatSending ? "bi-hourglass-split" : "bi-send-fill")"></i>
                            </button>
                        </div>
                    </div>
                }

                <!-- CONTENT TAB -->
                @if (_tab == "content")
                {
                    <div class="cls-content-list">
                        @if (_contentLoading)
                        {
                            <div class="loading-block"><div class="spin-ring"></div><div>Loading…</div></div>
                        }
                        else if (!_contentItems.Any())
                        {
                            <div class="empty-block">
                                <div><i class="bi bi-file-text-fill" style="font-size:2rem;color:var(--text-m)"></i></div>
                                <div>No content uploaded yet</div>
                            </div>
                        }
                        else
                        {
                            @foreach (var item in _contentItems)
                            {
                                <div class="content-card">
                                    <div class="content-card-icon"><i class="bi @ContentIcon(item.Type)" style="font-size:1.4rem"></i></div>
                                    <div class="content-card-body">
                                        <div class="content-card-title">@item.Title</div>
                                        <div class="content-card-meta">
                                            @item.Type
                                            @if (item.DueDate.HasValue) { <span> • Due @item.DueDate.Value.ToLocalTime().ToString("MMM d")</span> }
                                            @if (item.MaxPoints > 0) { <span> • @item.MaxPoints pts</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="content-card-desc">@item.Description</div>
                                        }
                                    </div>
                                    <div class="content-card-actions">
                                        @if (!string.IsNullOrEmpty(item.FilePath))
                                        {
                                            <a class="btn-sm btn-primary" href="@(GetBaseUrl() + item.FilePath)" target="_blank"><i class="bi bi-download"></i> Download</a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                <!-- MEMBERS TAB -->
                @if (_tab == "members")
                {
                    <div class="cls-members">
                        @if (_activeClass.Teacher != null)
                        {
                            <div class="member-row teacher-row">
                                <div class="member-av"><i class="bi bi-mortarboard-fill" style="font-size:1.3rem;color:var(--green)"></i></div>
                                <div>
                                    <div class="member-name">@_activeClass.Teacher</div>
                                    <div class="member-role">Teacher</div>
                                </div>
                            </div>
                        }
                        @foreach (var s in _activeClass.Students ?? new())
                        {
                            <div class="member-row">
                                <div class="member-av"><i class="bi bi-person-circle" style="font-size:1.3rem"></i></div>
                                <div>
                                    <div class="member-name">@s.DisplayName</div>
                                    <div class="member-role">Student</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- UPLOAD TAB (Teacher) -->
                @if (_tab == "upload" && IsTeacher)
                {
                    <div class="upload-form card">
                        <div class="page-head"><h1>Upload Content</h1></div>
                        <div class="form-group">
                            <label class="form-label">Title</label>
                            <input class="form-input" @bind="_uploadTitle" placeholder="Content title" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Type</label>
                            <select class="form-input" @bind="_uploadType">
                                <option>Note</option>
                                <option>PDF</option>
                                <option>Assignment</option>
                                <option>Announcement</option>
                                <option>Link</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea class="form-input" @bind="_uploadDesc" rows="3" placeholder="Optional description"></textarea>
                        </div>
                        @if (_uploadType == "Link")
                        {
                            <div class="form-group">
                                <label class="form-label">URL</label>
                                <input class="form-input" @bind="_uploadUrl" placeholder="https://" />
                            </div>
                        }
                        @if (_uploadType == "Assignment")
                        {
                            <div class="form-row">
                                <div class="form-group" style="flex:1">
                                    <label class="form-label">Due Date</label>
                                    <input class="form-input" type="date" @bind="_uploadDue" />
                                </div>
                                <div class="form-group" style="flex:1">
                                    <label class="form-label">Max Points</label>
                                    <input class="form-input" type="number" @bind="_uploadMaxPts" />
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_uploadMsg))
                        {
                            <div class="@(_uploadOk ? "alert-ok" : "alert-err")">@_uploadMsg</div>
                        }
                        <button class="btn btn-primary" @onclick="UploadContent" disabled="@_uploading">
                            @if (_uploading) { <text>Uploading…</text> } else { <i class="bi bi-cloud-upload-fill"></i><text> Upload</text> }
                        </button>
                    </div>
                }
            }
        </div>

    </div>
</div>

