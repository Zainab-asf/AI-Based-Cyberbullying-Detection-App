@page "/login"
@inject ApiService Api
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="login-root">

    <!-- ── Left branding panel ── -->
    <div class="login-left">
        <div class="login-left-inner">
            <img src="img/mascot-buddy.jpeg" class="mascot-panel" alt="KidSafe Buddy" />
            <div class="login-brand-name">KidSafe</div>
            <div class="login-brand-tag">AI-Powered Safe Learning Platform</div>

            <div class="login-feats">
                <div class="login-feat">
                    <span class="lf-ico"><i class="bi bi-cpu-fill"></i></span>
                    <div><div class="lf-ttl">AI Moderation</div><div class="lf-sub">Real-time content scanning</div></div>
                </div>
                <div class="login-feat">
                    <span class="lf-ico"><i class="bi bi-people-fill"></i></span>
                    <div><div class="lf-ttl">Family Connected</div><div class="lf-sub">Parent &amp; teacher oversight</div></div>
                </div>
                <div class="login-feat">
                    <span class="lf-ico"><i class="bi bi-trophy-fill"></i></span>
                    <div><div class="lf-ttl">Reward System</div><div class="lf-sub">Badges for good behaviour</div></div>
                </div>
                <div class="login-feat">
                    <span class="lf-ico"><i class="bi bi-lock-fill"></i></span>
                    <div><div class="lf-ttl">Secure &amp; Private</div><div class="lf-sub">End-to-end safe messaging</div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Right form panel ── -->
    <div class="login-right">
        <div class="login-box">

            <!-- Header -->
            <div class="login-box-hd">
                <img src="img/mascot-icon.jpeg" class="login-app-icon" alt="KidSafe" />
                <h1 class="login-box-title">Welcome Back</h1>
                <p class="login-box-sub">Select your role or enter your credentials</p>
            </div>

            <!-- Role cards -->
            <div class="role-cards">
                @foreach (var r in _roleOptions)
                {
                    var isActive = _selectedRole == r.Role;
                    <button class="role-card @(isActive ? "active" : "") rc-@r.Role.ToLower()"
                            type="button"
                            @onclick="() => SelectRole(r)">
                        <span class="rc-ico"><i class="bi @r.IconClass"></i></span>
                        <span class="rc-lbl">@r.Label</span>
                        @if (isActive)
                        {
                            <span class="rc-check"><i class="bi bi-check-circle-fill"></i></span>
                        }
                    </button>
                }
            </div>

            <!-- Demo hint -->
            @if (_selectedRole != null)
            {
                <div class="demo-hint">
                    <span class="demo-dot"><i class="bi bi-info-circle-fill"></i></span>
                    <span>Demo credentials filled — click <strong>Sign In</strong> to try the @_selectedRole portal</span>
                </div>
            }

            <!-- Error -->
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="auth-error">
                    <i class="bi bi-exclamation-triangle-fill"></i> @_error
                </div>
            }

            <!-- Form -->
            <div class="login-form">
                <div class="field">
                    <label class="field-label">Email address</label>
                    <div class="field-wrap">
                        <span class="field-icon"><i class="bi bi-envelope-fill"></i></span>
                        <input class="field-input" type="email" @bind="_email" @bind:event="oninput"
                               placeholder="your@email.com" />
                    </div>
                </div>
                <div class="field">
                    <label class="field-label">Password</label>
                    <div class="field-wrap">
                        <span class="field-icon"><i class="bi bi-key-fill"></i></span>
                        <input class="field-input" type="@(_showPwd ? "text" : "password")"
                               @bind="_password" @bind:event="oninput"
                               placeholder="••••••••" />
                        <button type="button" class="pwd-toggle" @onclick="() => _showPwd = !_showPwd"
                                title="@(_showPwd ? "Hide" : "Show")">
                            <i class="bi @(_showPwd ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                        </button>
                    </div>
                </div>
                <button class="btn btn-primary btn-block login-btn" type="button"
                        @onclick="Submit" disabled="@_busy">
                    @if (_busy)
                    {
                        <div class="spinner-sm"></div>
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right-short" style="font-size:1.2rem"></i>
                    }
                </button>
            </div>

            <div class="auth-note">
                <i class="bi bi-shield-lock-fill" style="color:var(--green)"></i>
                Accounts are created by your Administrator.<br />
                Contact your Admin if you need access.
            </div>

        </div>
    </div>
</div>

