@page "/notifications"
@inject ApiService Api
@inject AuthStateService AuthState
@inject SidebarService Sidebar
@inject NavigationManager Nav

<div class="app-root">

    <AppSidebar>
        <NavContent>
            <NavGroup Title="Navigation">
                <button class="nav-item" @onclick="GoBack">
                    <span class="ni"><i class="bi bi-arrow-left"></i></span><span>Back</span>
                </button>
                <button class="nav-item active">
                    <span class="ni"><i class="bi bi-bell-fill"></i></span><span>Notifications</span>
                </button>
            </NavGroup>
        </NavContent>
    </AppSidebar>

    <div class="main-area">
        <header class="top-header">
            <button class="sidebar-toggle" @onclick="Sidebar.ToggleDrawer" title="Menu">
                <i class="bi bi-list"></i>
            </button>
            <div class="header-title"><i class="bi bi-bell-fill"></i> Notifications</div>
            <div class="header-actions" style="margin-left:auto">
                @if (_notifications.Any(n => !n.IsRead))
                {
                    <button class="btn btn-sm btn-outline" @onclick="MarkAllRead">Mark all read</button>
                }
                <button class="header-btn" @onclick="Load" title="Refresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </header>

        <div class="page-content">
            @if (_loading)
            {
                <div class="loading-block">
                    <div class="spinner"></div>
                </div>
            }
            else if (!_notifications.Any())
            {
                <div class="empty-block">
                    <div class="empty-ico"><i class="bi bi-bell-fill" style="color:var(--text-m)"></i></div>
                    <div class="empty-txt">No notifications</div>
                    <div class="empty-sub">You're all caught up!</div>
                </div>
            }
            else
            {
                @foreach (var n in _notifications)
                {
                    <div class="notif-row @(n.IsRead ? "" : "unread")" @onclick="() => ReadNote(n)">
                        <div class="notif-icon @n.Type"><i class="bi @NoteIcon(n.Type)"></i></div>
                        <div class="notif-body">
                            <div class="notif-title">@n.Title</div>
                            <div class="notif-text">@n.Body</div>
                            <div class="notif-time">@TimeAgo(n.CreatedAt)</div>
                        </div>
                        @if (!n.IsRead)
                        {
                            <div class="notif-dot"></div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

