@page "/dashboard"
@inject ApiService Api
@inject AuthStateService AuthState
@inject SidebarService Sidebar
@inject ChatHubService Hub
@inject FcmService Fcm
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="app-root portal-parent">

    <AppSidebar>
        <NavContent>
            <NavGroup Title="Overview">
                <button class="nav-item active">
                    <span class="ni"><i class="bi bi-bar-chart-fill"></i></span><span>Dashboard</span>
                </button>
            </NavGroup>
            <NavGroup Title="Children">
                @foreach (var child in _children)
                {
                    <button class="nav-item @(_selectedChildId == child.ChildId ? "active" : "")"
                            @onclick="() => SelectChild(child.ChildId)">
                        <span class="ni"><UserAvatar Name="@child.Name" Size="xs" Role="child" /></span>
                        <span>@child.Name</span>
                    </button>
                }
            </NavGroup>
            <NavGroup Title="Alerts">
                <button class="nav-item @(_selectedChildId == 0 ? "active" : "")" @onclick="ShowAllChildren">
                    <span class="ni"><i class="bi bi-exclamation-triangle-fill"></i></span><span>All Flags</span>
                    @if (_flaggedMessages.Count > 0) { <span class="nb">@_flaggedMessages.Count</span> }
                </button>
                <button class="nav-item" @onclick="ShowWatch">
                    <span class="ni"><i class="bi bi-eye-fill"></i></span><span>Watch</span>
                </button>
                <button class="nav-item" @onclick="ShowReview">
                    <span class="ni"><i class="bi bi-x-circle-fill"></i></span><span>Review</span>
                </button>
            </NavGroup>
            <NavGroup Title="Account">
                <button class="nav-item" @onclick='() => Nav.NavigateTo("/notifications")'>
                    <span class="ni"><i class="bi bi-bell-fill"></i></span><span>Notifications</span>
                </button>
                <button class="nav-item" @onclick='() => Nav.NavigateTo("/profile")'>
                    <span class="ni"><i class="bi bi-person-circle"></i></span><span>Profile</span>
                </button>
            </NavGroup>
        </NavContent>
    </AppSidebar>

    <!-- ── Main area ── -->
    <div class="main-area">
        <!-- Top header -->
        <header class="top-header">
            <button class="sidebar-toggle" @onclick="Sidebar.ToggleDrawer" title="Menu">
                <i class="bi bi-list"></i>
            </button>
            <div class="header-title">Parent Dashboard</div>
            @if (!string.IsNullOrEmpty(_fcmToast))
            {
                <div class="badge badge-coral" style="font-size:.75rem;padding:.3rem .75rem"><i class="bi bi-bell-fill"></i> @_fcmToast</div>
            }
            <div class="header-actions" style="margin-left:auto">
                <button class="header-btn" @onclick="LoadData" title="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
                <div class="header-profile">
                    <UserAvatar Name="@(AuthState.CurrentUser?.DisplayName ?? "Parent")" Size="sm" Role="parent" />
                    <div>
                        <div class="hp-name">@(AuthState.CurrentUser?.DisplayName ?? "Parent")</div>
                        <div class="hp-role">Parent</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <div class="page-content">

            <!-- Profile card -->
            <DashboardProfileCard RoleKey="parent"
                Name="@(AuthState.CurrentUser?.DisplayName ?? "Parent")"
                Role="Parent Account"
                Meta="@($"{_children.Count} linked {(_children.Count == 1 ? "child" : "children")} · {_flaggedMessages.Count} flags to review")">
                <Actions>
                    <button class="btn btn-sm btn-outline" @onclick='() => Nav.NavigateTo("/profile")'><i class="bi bi-person-circle"></i> Profile</button>
                    <button class="btn btn-sm btn-outline" @onclick='() => Nav.NavigateTo("/notifications")'><i class="bi bi-bell-fill"></i> Alerts</button>
                </Actions>
            </DashboardProfileCard>

            <!-- Hero banner -->
            @if (_stats != null)
            {
                var heroClass = _stats.TotalReview > 5 ? "coral" : _stats.TotalWatch > 10 ? "" : "";
                var heroIcon  = _stats.TotalReview > 5 ? "bi-exclamation-octagon-fill" : _stats.TotalWatch > 10 ? "bi-exclamation-triangle-fill" : "bi-shield-check-fill";
                var heroTitle = _stats.TotalReview > 5 ? "High Risk Activity Detected" : _stats.TotalWatch > 10 ? "Some Activity to Review" : "All Clear — Classroom Safe";
                var heroSub   = _stats.TotalReview > 5 ? "Multiple flagged messages need your attention." : _stats.TotalWatch > 10 ? "Some messages are under watch." : "No concerning activity found today.";
                <div class="hero-banner @heroClass">
                    <div class="hero-text">
                        <div class="hero-title">@heroTitle</div>
                        <div class="hero-sub">@heroSub</div>
                        <div class="hero-chips">
                            <div class="hero-chip"><i class="bi bi-eye-fill"></i> @_stats.TotalWatch Watch</div>
                            <div class="hero-chip"><i class="bi bi-slash-circle-fill"></i> @_stats.TotalReview Review</div>
                            <div class="hero-chip"><i class="bi bi-bar-chart-fill"></i> @_stats.TotalFlagged Total Flags</div>
                        </div>
                    </div>
                    <img src="img/mascot-buddy.jpeg" class="mascot-banner" alt="KidSafe Buddy" style="width:90px;height:90px;object-fit:cover;border-radius:50%;flex-shrink:0;opacity:.92" />
                </div>

                <!-- Stats -->
                <div class="grid-3" style="margin-bottom:1.5rem">
                    <StatCard IconClass="bi-shield-check-fill" Value="@(_stats.TotalFlagged == 0 ? "All" : "—")" Label="Safe"   Color="green" />
                    <StatCard IconClass="bi-eye-fill"          Value="@_stats.TotalWatch.ToString()"             Label="Watch"  Color="gold"  />
                    <StatCard IconClass="bi-slash-circle-fill" Value="@_stats.TotalReview.ToString()"            Label="Review" Color="coral" />
                </div>
            }

            <!-- Live alerts -->
            @if (_liveAlerts.Any())
            {
                <div class="sec-hd"><h2><span class="live-dot"></span><i class="bi bi-bell-fill" style="margin-left:.35rem"></i> Live Alerts</h2></div>
                @foreach (var a in _liveAlerts.AsEnumerable().Reverse().Take(5))
                {
                    <div class="alert-row @(a.Label == "Review" ? "alert-danger" : "alert-warn")">
                        <div class="alert-ico"><i class="bi @(a.Label == "Review" ? "bi-exclamation-octagon-fill" : "bi-eye-fill")" style="color:@(a.Label == "Review" ? "var(--danger)" : "var(--warning)")"></i></div>
                        <div style="flex:1;min-width:0">
                            <div class="alert-sender">@a.SenderName</div>
                            <div class="alert-msg">@a.MaskedMessage</div>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.25rem">
                            <span class="badge @(a.Label == "Review" ? "badge-red" : "badge-gold")">@a.Label</span>
                            <span style="font-size:.65rem;color:var(--text-m)">@a.Time.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    </div>
                }
                <div style="margin-bottom:1.25rem"></div>
            }

            <!-- My Children -->
            @if (_children.Any())
            {
                <div class="sec-hd" style="margin-bottom:.75rem"><h2><i class="bi bi-people-fill"></i> My Children</h2></div>
                <div class="grid-auto" style="margin-bottom:1.5rem">
                    @foreach (var child in _children)
                    {
                        <div class="class-card @(_selectedChildId == child.ChildId ? "active-child" : "")"
                             @onclick="() => SelectChild(child.ChildId)">
                            <div class="class-card-icon"><UserAvatar Name="@child.Name" Size="sm" Role="child" /></div>
                            <div class="class-card-name">@child.Name</div>
                            <div class="class-card-sub">@child.Email</div>
                            <div class="class-card-stats">
                                <span class="badge @(child.Status == "active" ? "badge-green" : "badge-gold")">@child.Status</span>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Flagged messages -->
            <div class="sec-hd">
                <h2><i class="bi bi-flag-fill"></i> @(_selectedChildId > 0 ? $"{_children.FirstOrDefault(c => c.ChildId == _selectedChildId)?.Name}'s" : "All") Flagged Messages</h2>
            </div>

            <!-- Filter tabs -->
            <div class="page-tabs" style="margin-bottom:1rem">
                <button class="ptab @(_filter == "All"    ? "active" : "")" @onclick="ShowAll">All</button>
                <button class="ptab @(_filter == "Watch"  ? "active" : "")" @onclick="ShowWatch"><i class="bi bi-eye-fill"></i> Watch</button>
                <button class="ptab @(_filter == "Review" ? "active" : "")" @onclick="ShowReview"><i class="bi bi-slash-circle-fill"></i> Review</button>
            </div>

            @if (_loading)
            {
                <div class="loading-block"><div class="spinner"></div></div>
            }
            else if (!FilteredMessages.Any())
            {
                <div class="empty-block">
                    <div class="empty-ico"><i class="bi bi-shield-check-fill" style="font-size:2rem;color:var(--green)"></i></div>
                    <div class="empty-txt">No flagged messages</div>
                    <div class="empty-sub">Everything looks good!</div>
                </div>
            }
            else
            {
                <div class="tbl-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Message</th>
                                <th>Label</th>
                                <th>Risk Score</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in FilteredMessages)
                            {
                                <tr>
                                    <td><span style="font-weight:600">@m.SenderName</span></td>
                                    <td style="max-width:240px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@m.MaskedMessage</td>
                                    <td><span class="badge @(m.Label == "Review" ? "badge-red" : "badge-gold")">@m.Label</span></td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:.5rem">
                                            <div class="score-bar-mini">
                                                <div class="score-fill-mini @(m.Score>=.8?"hi":m.Score>=.5?"md":"lo")"
                                                     style="width:@((int)(m.Score*100))%"></div>
                                            </div>
                                            <span style="font-size:.72rem;font-weight:700">@m.Score.ToString("P0")</span>
                                        </div>
                                    </td>
                                    <td style="font-size:.72rem;color:var(--text-m)">@m.Timestamp.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div><!-- /page-content -->
    </div><!-- /main-area -->
</div><!-- /app-root -->

<!-- Mobile bottom nav -->
<nav class="mobile-nav" style="display:none">
    <button class="mnav-item active"><i class="bi bi-bar-chart-fill"></i><span>Dashboard</span></button>
    <button class="mnav-item" @onclick="LoadData"><i class="bi bi-arrow-clockwise"></i><span>Refresh</span></button>
    <button class="mnav-item" @onclick="Logout"><i class="bi bi-box-arrow-right"></i><span>Logout</span></button>
</nav>

